 "brief": {
  "d": "2026-10-26",
  "createdAt": "2026-10-26T09:30:00Z",
  "headline": "Magic win at Knicks 111-102 for Sweeney's first win; Suggs hurt",
  "summary": "Orlando (1-2) erased a 12-0 deficit and outscored New York 40-27 in the fourth quarter to win at Madison Square Garden without Paolo Banchero. Franz Wagner had 21 of his 23 points in the fourth. Jalen Suggs hurt his right knee late and will be evaluated. The Magic play at Toronto on Wednesday and again Friday.",
  "bullets": [
   {
    "tag": "Game",
    "text": "Magic 111, Knicks 102. Orlando trailed 12-0, took its first lead with 7:25 left in the fourth and handed the defending champions an 0-3 start (Yahoo Sports, Deadspin)."
   },
   {
    "tag": "Lineup",
    "text": "Wagner 23 pts, 13 reb (career high), 9 ast; Desmond Bane 22 pts, including the go-ahead three; Tristan da Silva 19 pts off the bench."
   },
   {
    "tag": "Health",
    "text": "Anthony Black returned from his right ankle sprain with 18 pts, 5 ast in 26 minutes and a team-best +21."
   },
   {
    "tag": "Health",
    "text": "Suggs (6 reb, 6 ast, 3 stl) was helped off with an apparent right knee injury late in the fourth. Sweeney had no update after the game."
   },
   {
    "tag": "Health",
    "text": "Banchero (low-grade right high ankle sprain) is out, reported 4-6 weeks. Isaac, Penda and Nelson also remain out."
   },
   {
    "tag": "Next game",
    "text": "At Toronto Wednesday, 7:30 PM ET, TV27, with a second game in Toronto Friday. Odds not yet confirmed."
   }
  ],
  "recap": {
   "title": "Magic 111, Knicks 102",
   "text": "Orlando overcame a 12-0 start by New York and a missing Banchero, outscoring the Knicks 40-27 in the fourth. Bane hit the three that gave Orlando the lead for good.",
   "leaders": "Wagner 23 pts, 13 reb, 9 ast; Bane 22 pts; da Silva 19 pts; Black 18 pts, 5 ast"
  },
  "preview": {
   "title": "Wednesday at Raptors, 7:30 PM, TV27",
   "text": "Toronto is 2-0. Suggs is a question mark after his knee injury; Banchero remains out.",
   "line": "Line not yet posted"
  },
  "watch": "Suggs' knee evaluation, then at Toronto Wednesday, 7:30 PM."
 },
